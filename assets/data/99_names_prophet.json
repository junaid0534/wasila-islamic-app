[
  {"id": 1, "arabic": "مُحَمَّدٌ ﷺ", "transliteration": "Muhammad", "englishMeaning": "The Praised One", "urduMeaning": "جس کی کثرت سے تعریف کی گئی ہو"},
  {"id": 2, "arabic": "أَحْمَدُ ﷺ", "transliteration": "Ahmad", "englishMeaning": "The Most Commendable", "urduMeaning": "اللہ کی سب سے زیادہ تعریف کرنے والا"},
  {"id": 3, "arabic": "حَامِدٌ ﷺ", "transliteration": "Hamid", "englishMeaning": "The Praiser of Allah", "urduMeaning": "اللہ کی حمد و ثنا بیان کرنے والا"},
  {"id": 4, "arabic": "مَحْمُودٌ ﷺ", "transliteration": "Mahmood", "englishMeaning": "The Praised & Esteemed", "urduMeaning": "پسندیدہ اور قابلِ تعریف"},
  {"id": 5, "arabic": "قَاسِمٌ ﷺ", "transliteration": "Qasim", "englishMeaning": "The Distributor of Blessings", "urduMeaning": "اللہ کی نعمتیں تقسیم فرمانے والا"},
  {"id": 6, "arabic": "عَاقِبٌ ﷺ", "transliteration": "Aqib", "englishMeaning": "The Last in Succession", "urduMeaning": "سب سے آخر میں تشریف لانے والا (خاتم النبیین)"},
  {"id": 7, "arabic": "فَاتِحٌ ﷺ", "transliteration": "Fatih", "englishMeaning": "The Opener / Victor", "urduMeaning": "رحمت اور ہدایت کے دروازے کھولنے والا"},
  {"id": 8, "arabic": "خَاتَمٌ ﷺ", "transliteration": "Khatam", "englishMeaning": "The Seal of the Prophets", "urduMeaning": "سلسلہ نبوت کو مکمل فرمانے والا"},
  {"id": 9, "arabic": "حَاشِرٌ ﷺ", "transliteration": "Hashir", "englishMeaning": "The Gatherer", "urduMeaning": "جس کے قدموں تلے میدانِ حشر میں لوگ جمع کیے جائیں گے"},
  {"id": 10, "arabic": "مَاحِي ﷺ", "transliteration": "Mahi", "englishMeaning": "The Eraser of Disbelief", "urduMeaning": "کفر و شرک کو مٹانے والا"},
  {"id": 11, "arabic": "نَبِيُّ الرَّحْمَةِ ﷺ", "transliteration": "Nabiyy-ur-Rahmah", "englishMeaning": "The Prophet of Mercy", "urduMeaning": "سراپا رحمت بنا کر بھیجا گیا نبی"},
  {"id": 12, "arabic": "نَبِيُّ التَّوْبَةِ ﷺ", "transliteration": "Nabiyy-ut-Tawbah", "englishMeaning": "The Prophet of Repentance", "urduMeaning": "توبہ کی راہ دکھانے والا نبی"},
  {"id": 13, "arabic": "نَبِيُّ الْمَلَاحِمِ ﷺ", "transliteration": "Nabiyy-ul-Malahim", "englishMeaning": "The Prophet of Struggles & Triumph", "urduMeaning": "حق کے معرکوں کے قائد"},
  {"id": 14, "arabic": "طٰهٰ ﷺ", "transliteration": "Ta-Ha", "englishMeaning": "Pure & Guiding (Quranic Title)", "urduMeaning": "اے پاکیزہ و کامل رہنما"},
  {"id": 15, "arabic": "يٰسٓ ﷺ", "transliteration": "Ya-Seen", "englishMeaning": "Chief of Mankind (Quranic Title)", "urduMeaning": "اے کامل انسان و سردار"},
  {"id": 16, "arabic": "مُزَّمِّلٌ ﷺ", "transliteration": "Muzzammil", "englishMeaning": "The Enfolded in Cloak", "urduMeaning": "کملی میں لپٹنے والا"},
  {"id": 17, "arabic": "مُدَّثِّرٌ ﷺ", "transliteration": "Muddaththir", "englishMeaning": "The Cloaked One", "urduMeaning": "چادر اوڑھنے والا"},
  {"id": 18, "arabic": "نَذِيرٌ ﷺ", "transliteration": "Nadheer", "englishMeaning": "The Warner", "urduMeaning": "عذابِ الٰہی سے ڈرانے والا"},
  {"id": 19, "arabic": "بَشِيرٌ ﷺ", "transliteration": "Basheer", "englishMeaning": "The Bringer of Glad Tidings", "urduMeaning": "جنت کی خوشخبری دینے والا"},
  {"id": 20, "arabic": "سِرَاجٌ مُنِيرٌ ﷺ", "transliteration": "Sirajum-Muneer", "englishMeaning": "The Illuminating Lamp", "urduMeaning": "روشن چراغ جو تاریکیاں مٹا دے"},
  {"id": 21, "arabic": "مُنْذِرٌ ﷺ", "transliteration": "Mundhir", "englishMeaning": "The Admonisher", "urduMeaning": "نصیحت فرمانے والا"},
  {"id": 22, "arabic": "هَادِي ﷺ", "transliteration": "Hadi", "englishMeaning": "The Guide to the Right Path", "urduMeaning": "صراطِ مستقیم کی رہنمائی فرمانے والا"},
  {"id": 23, "arabic": "مَهْدِيٌّ ﷺ", "transliteration": "Mahdi", "englishMeaning": "The Divinely Guided", "urduMeaning": "اللہ کی کامل ہدایت پر قائم"},
  {"id": 24, "arabic": "رَسُولُ الرَّحْمَةِ ﷺ", "transliteration": "Rasool-ur-Rahmah", "englishMeaning": "Messenger of Mercy", "urduMeaning": "رحمت کے پیامبر"},
  {"id": 25, "arabic": "صَادِقٌ ﷺ", "transliteration": "Sadiq", "englishMeaning": "The Truthful", "urduMeaning": "ہمیشہ سچ بولنے والا"},
  {"id": 26, "arabic": "أَمِينٌ ﷺ", "transliteration": "Ameen", "englishMeaning": "The Trustworthy", "urduMeaning": "امانت دار اور قابلِ اعتماد"},
  {"id": 27, "arabic": "رَءُوفٌ ﷺ", "transliteration": "Ra'oof", "englishMeaning": "The Compassionate", "urduMeaning": "امت پر انتہائی شفقت فرمانے والا"},
  {"id": 28, "arabic": "رَحِيمٌ ﷺ", "transliteration": "Raheem", "englishMeaning": "The Merciful", "urduMeaning": "مومنین پر بے پایاں رحم فرمانے والا"},
  {"id": 29, "arabic": "مُجْتَبَىٰ ﷺ", "transliteration": "Mujtaba", "englishMeaning": "The Chosen One", "urduMeaning": "اللہ کا منتخب و برگزیدہ بندہ"},
  {"id": 30, "arabic": "مُصْطَفَىٰ ﷺ", "transliteration": "Mustafa", "englishMeaning": "The Preferred & Pure", "urduMeaning": "تمام کائنات میں سب سے چنیدہ ذات"},
  {"id": 31, "arabic": "مُرْتَضَىٰ ﷺ", "transliteration": "Murtada", "englishMeaning": "The Pleasing to Allah", "urduMeaning": "جس سے اللہ مکمل راضی ہوا"},
  {"id": 32, "arabic": "شَفِيعٌ ﷺ", "transliteration": "Shafi'", "englishMeaning": "The Intercessor", "urduMeaning": "روزِ محشر گناہگاروں کی شفاعت فرمانے والا"},
  {"id": 33, "arabic": "مُشَفَّعٌ ﷺ", "transliteration": "Mushaffa'", "englishMeaning": "The Accepted Intercessor", "urduMeaning": "جس کی شفاعت بارگاہِ الٰہی میں لازماً قبول ہو"},
  {"id": 34, "arabic": "مُطَاعٌ ﷺ", "transliteration": "Muta'", "englishMeaning": "The Obeyed Leader", "urduMeaning": "جس کی اطاعت اللہ نے فرض قرار دی"},
  {"id": 35, "arabic": "نَبِيٌّ أُمِّيٌّ ﷺ", "transliteration": "Nabiyy-ul-Ummi", "englishMeaning": "The Unlettered Prophet (Taught by Allah)", "urduMeaning": "جسے براہِ راست اللہ نے تمام علوم سکھائے"},
  {"id": 36, "arabic": "حَبِيبُ اللَّهِ ﷺ", "transliteration": "Habeebullah", "englishMeaning": "The Beloved of Allah", "urduMeaning": "اللہ کا پیارا اور محبوب"},
  {"id": 37, "arabic": "خَلِيلُ الرَّحْمَٰنِ ﷺ", "transliteration": "Khaleel-ur-Rahman", "englishMeaning": "The Intimate Friend of Allah", "urduMeaning": "رحمٰن کا خاص دوست"},
  {"id": 38, "arabic": "سَيِّدُ الْمُرْسَلِينَ ﷺ", "transliteration": "Sayyid-ul-Mursaleen", "englishMeaning": "Leader of All Messengers", "urduMeaning": "تمام رسولوں اور انبیاء کے سردار"},
  {"id": 39, "arabic": "إِمَامُ الْمُتَّقِينَ ﷺ", "transliteration": "Imam-ul-Muttaqeen", "englishMeaning": "Guide of the Righteous", "urduMeaning": "تمام پرہیزگاروں کے پیشوا"},
  {"id": 40, "arabic": "قَائِدُ الْغُرِّ الْمُحَجَّلِينَ ﷺ", "transliteration": "Qaid-ul-Ghurril Muhajjaleen", "englishMeaning": "Leader of the Radiant Worshippers", "urduMeaning": "چمکتے چہروں والے وضو کرنے والوں کے قائد"},
  {"id": 41, "arabic": "صَاحِبُ الشَّفَاعَةِ ﷺ", "transliteration": "Sahib-ush-Shafa'ah", "englishMeaning": "Master of Supreme Intercession", "urduMeaning": "مقامِ محمود اور شفاعتِ کبرا کے مالک"},
  {"id": 42, "arabic": "صَاحِبُ الْوَسِيلَةِ ﷺ", "transliteration": "Sahib-ul-Waseelah", "englishMeaning": "Owner of the Highest Heavenly Station", "urduMeaning": "وسیلہ اور بلند ترین مرتبے کے مالک"},
  {"id": 43, "arabic": "صَاحِبُ التَّاجِ ﷺ", "transliteration": "Sahib-ut-Taj", "englishMeaning": "The Wearer of the Heavenly Crown", "urduMeaning": "عزت اور بزرگی کے تاج والے"},
  {"id": 44, "arabic": "صَاحِبُ الْمِعْرَاجِ ﷺ", "transliteration": "Sahib-ul-Mi'raj", "englishMeaning": "The Ascender to Heavens", "urduMeaning": "معراجِ آسمانی کی رفعتیں پانے والے"},
  {"id": 45, "arabic": "صَاحِبُ الْبُرَاقِ ﷺ", "transliteration": "Sahib-ul-Buraq", "englishMeaning": "Rider of the Buraq", "urduMeaning": "براق کی سواری فرمانے والے"},
  {"id": 46, "arabic": "صَاحِبُ الْحُجَّةِ ﷺ", "transliteration": "Sahib-ul-Hujjah", "englishMeaning": "Bringer of Conclusive Proof", "urduMeaning": "روشن اور ناقابلِ تردید دلائل والے"},
  {"id": 47, "arabic": "صَاحِبُ السُّلْطَانِ ﷺ", "transliteration": "Sahib-us-Sultan", "englishMeaning": "Bearer of Divine Authority", "urduMeaning": "حقیقی غلبے اور اختیارات والے"},
  {"id": 48, "arabic": "صَاحِبُ الْفَضِيلَةِ ﷺ", "transliteration": "Sahib-ul-Fadeelah", "englishMeaning": "Owner of Supreme Excellence", "urduMeaning": "بے مثال فضل و فضیلت والے"},
  {"id": 49, "arabic": "صَاحِبُ الْإِزَارِ ﷺ", "transliteration": "Sahib-ul-Izar", "englishMeaning": "Embodiment of Humility", "urduMeaning": "سادگی اور پاکیزگی کے پیکر"},
  {"id": 50, "arabic": "صَاحِبُ الْبُرْهَانِ ﷺ", "transliteration": "Sahib-ul-Burhan", "englishMeaning": "Owner of the Clear Proof", "urduMeaning": "حق کے کھلے ثبوت والے"},
  {"id": 51, "arabic": "صَاحِبُ الْبَيَانِ ﷺ", "transliteration": "Sahib-ul-Bayan", "englishMeaning": "Master of Eloquence", "urduMeaning": "فصاحت اور جوامع الکلم کے مالک"},
  {"id": 52, "arabic": "مُذَكِّرٌ ﷺ", "transliteration": "Mudhakir", "englishMeaning": "The Reminder", "urduMeaning": "اللہ کی یاد دلانے والے"},
  {"id": 53, "arabic": "وَاعِظٌ ﷺ", "transliteration": "Wa'iz", "englishMeaning": "The Preacher of Wisdom", "urduMeaning": "نصیحت اور دانائی بیان فرمانے والے"},
  {"id": 54, "arabic": "مُبَلِّغٌ ﷺ", "transliteration": "Muballigh", "englishMeaning": "The Conveyor of Message", "urduMeaning": "پیغامِ حق مکمل پہنچانے والے"},
  {"id": 55, "arabic": "نَاصِحٌ ﷺ", "transliteration": "Nasih", "englishMeaning": "The Sincere Well-Wisher", "urduMeaning": "امت کے سب سے بڑے خیر خواہ"},
  {"id": 56, "arabic": "مُشْفِقٌ ﷺ", "transliteration": "Mushfiq", "englishMeaning": "The Tender-Hearted", "urduMeaning": "نہایت مہربان اور ہمدرد"},
  {"id": 57, "arabic": "مُعَلِّمٌ ﷺ", "transliteration": "Mu'allim", "englishMeaning": "The Teacher of Humanity", "urduMeaning": "انسانیت کے عظیم ترین استاد"},
  {"id": 58, "arabic": "طَاهِرٌ ﷺ", "transliteration": "Tahir", "englishMeaning": "The Pure", "urduMeaning": "ہر ظاہری و باطنی عیب سے پاک"},
  {"id": 59, "arabic": "مُطَهَّرٌ ﷺ", "transliteration": "Mutahhar", "englishMeaning": "The Purified One", "urduMeaning": "جسے اللہ نے پاکیزہ بنایا"},
  {"id": 60, "arabic": "طَيِّبٌ ﷺ", "transliteration": "Tayyib", "englishMeaning": "The Good & Pleasant", "urduMeaning": "پاکیزہ اور خوشبودار ذات"},
  {"id": 61, "arabic": "مُقَدَّسٌ ﷺ", "transliteration": "Muqaddas", "englishMeaning": "The Sacred", "urduMeaning": "مقدس اور برکت والی ذات"},
  {"id": 62, "arabic": "شَاهِدٌ ﷺ", "transliteration": "Shahid", "englishMeaning": "The Witness", "urduMeaning": "قیامت کے دن امتوں پر گواہ"},
  {"id": 63, "arabic": "شَهِيدٌ ﷺ", "transliteration": "Shaheed", "englishMeaning": "The Supreme Witness", "urduMeaning": "حق کا شاہد اور حاضر و ناظر"},
  {"id": 64, "arabic": "مَشْهُودٌ ﷺ", "transliteration": "Mashhood", "englishMeaning": "The One Witnessed Upon", "urduMeaning": "جس کی نبوت کی کائنات نے گواہی دی"},
  {"id": 65, "arabic": "دَاعِي إِلَى اللَّهِ ﷺ", "transliteration": "Da'i Ilallah", "englishMeaning": "The Caller to Allah", "urduMeaning": "اللہ کی طرف بلانے والے"},
  {"id": 66, "arabic": "مُجِيبُ الدَّعْوَةِ ﷺ", "transliteration": "Mujeeb-ud-Da'wah", "englishMeaning": "The Acceptor of Invitations", "urduMeaning": "غریبوں کی دعوت قبول فرمانے والے"},
  {"id": 67, "arabic": "عَفُوٌّ ﷺ", "transliteration": "Afuww", "englishMeaning": "The Forgiving", "urduMeaning": "دشمنوں کو بھی معاف فرما دینے والے"},
  {"id": 68, "arabic": "مُقْتَصِدٌ ﷺ", "transliteration": "Muqtasid", "englishMeaning": "The Moderate & Balanced", "urduMeaning": "میانہ روی اور عدل پر قائم"},
  {"id": 69, "arabic": "مُتَوَكِّلٌ ﷺ", "transliteration": "Mutawakkil", "englishMeaning": "The Reliant on Allah", "urduMeaning": "ہر معاملے میں اللہ پر بھروسہ کرنے والے"},
  {"id": 70, "arabic": "كَرِيمٌ ﷺ", "transliteration": "Kareem", "englishMeaning": "The Noble & Generous", "urduMeaning": "سخاوت اور کرم کا سمندر"},
  {"id": 71, "arabic": "جَوَادٌ ﷺ", "transliteration": "Jawad", "englishMeaning": "The Magnanimous Giver", "urduMeaning": "بے دریغ عطا فرمانے والے"},
  {"id": 72, "arabic": "عَظِيمٌ ﷺ", "transliteration": "Azeem", "englishMeaning": "The Magnificent in Character", "urduMeaning": "خُلقِ عظیم کے مالک (*وانک لعلی خلق عظیم*)"},
  {"id": 73, "arabic": "حَكِيمٌ ﷺ", "transliteration": "Hakeem", "englishMeaning": "The Wise", "urduMeaning": "حکمت اور دانائی سے بھرپور"},
  {"id": 74, "arabic": "حَلِيمٌ ﷺ", "transliteration": "Haleem", "englishMeaning": "The Forbearing", "urduMeaning": "بردبار اور صبر کے پہاڑ"},
  {"id": 75, "arabic": "صَبُورٌ ﷺ", "transliteration": "Saboor", "englishMeaning": "The Most Patient", "urduMeaning": "تکالیف پر کمال صبر فرمانے والے"},
  {"id": 76, "arabic": "شَكُورٌ ﷺ", "transliteration": "Shakoor", "englishMeaning": "The Most Grateful", "urduMeaning": "اللہ کے کثرت سے شکر گزار بندے"},
  {"id": 77, "arabic": "قَوِيٌّ ﷺ", "transliteration": "Qawiyy", "englishMeaning": "The Strong in Faith & Deed", "urduMeaning": "حق کے نفاذ میں طاقتور"},
  {"id": 78, "arabic": "مَتِينٌ ﷺ", "transliteration": "Mateen", "englishMeaning": "The Steadfast", "urduMeaning": "دین پر ثابت قدم رہنے والے"},
  {"id": 79, "arabic": "مَأْمُونٌ ﷺ", "transliteration": "Ma'moon", "englishMeaning": "The Safe & Reliable", "urduMeaning": "جس کی پناہ میں ہر کوئی محفوظ ہو"},
  {"id": 80, "arabic": "قَرِيبٌ ﷺ", "transliteration": "Qareeb", "englishMeaning": "The Close to Believers", "urduMeaning": "مومنوں کی جان سے بھی قریب (*النبی اولی بالمؤمنین*)"},
  {"id": 81, "arabic": "حَبِيبٌ ﷺ", "transliteration": "Habeeb", "englishMeaning": "The Beloved", "urduMeaning": "ہر دل کا پیارا"},
  {"id": 82, "arabic": "مَحْبُوبٌ ﷺ", "transliteration": "Mahboob", "englishMeaning": "The Loved One", "urduMeaning": "جس سے سب محبت کریں"},
  {"id": 83, "arabic": "صَفِيُّ اللَّهِ ﷺ", "transliteration": "Safiyyullah", "englishMeaning": "The Pure Friend of Allah", "urduMeaning": "اللہ کے مخلص دوست"},
  {"id": 84, "arabic": "نَجِيُّ اللَّهِ ﷺ", "transliteration": "Najiyyullah", "englishMeaning": "The Confidant of Allah", "urduMeaning": "اللہ سے راز و نیاز پانے والے"},
  {"id": 85, "arabic": "كَلِيمُ اللَّهِ ﷺ", "transliteration": "Kaleemullah", "englishMeaning": "The Converser with Allah (at Mi'raj)", "urduMeaning": "شبِ معراج اللہ سے کلام فرمانے والے"},
  {"id": 86, "arabic": "بُرْهَانُ اللَّهِ ﷺ", "transliteration": "Burhanullah", "englishMeaning": "Proof of Allah", "urduMeaning": "اللہ کی زندہ دلیل"},
  {"id": 87, "arabic": "حُجَّةُ اللَّهِ ﷺ", "transliteration": "Hujjatullah", "englishMeaning": "The Argument of Allah", "urduMeaning": "کائنات پر اللہ کی حجت"},
  {"id": 88, "arabic": "نُورُ اللَّهِ ﷺ", "transliteration": "Noorullah", "englishMeaning": "The Divine Light", "urduMeaning": "اللہ کا چمکتا ہوا نور (*قد جاءکم من اللہ نور*)"},
  {"id": 89, "arabic": "عَبْدُ اللَّهِ ﷺ", "transliteration": "Abdullah", "englishMeaning": "The True Servant of Allah", "urduMeaning": "اللہ کے سب سے کامل بندے"},
  {"id": 90, "arabic": "سَيِّدُ وَلَدِ آدَمَ ﷺ", "transliteration": "Sayyidu Waladi Adam", "englishMeaning": "Master of the Children of Adam", "urduMeaning": "تمام بنی نوع انسان کے سردار"},
  {"id": 91, "arabic": "فَخْرُ الْعَرَبِ وَالْعَجَمِ ﷺ", "transliteration": "Fakhr-ul-Arab wal Ajam", "englishMeaning": "Pride of All Mankind", "urduMeaning": "عرب و عجم کا فخر"},
